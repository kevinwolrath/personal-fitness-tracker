# Copy to .env.local (git-ignored) for local web and Android development. Never commit real values.
# Google Play builds get these from GitHub Actions instead: variable BODY_ANVIL_API_URL, secret BODY_ANVIL_ENROLLMENT_KEY.
# After changing a value, restart Expo with --clear (Metro caches inlined EXPO_PUBLIC_ values).

# Body Anvil API base URL. No default: without it, health data sync is off.
#   Web, against a local Worker (wrangler dev):  http://localhost:8787
#   Android emulator dev build:                  http://10.0.2.2:8787   (the emulator's address for this PC)
#   Physical phone dev build, same Wi-Fi:         http://<this PC's LAN IP>:8787
#   Release builds (APK, Play):                  https:// only
EXPO_PUBLIC_BODY_ANVIL_API_URL=
# Must equal BODY_ANVIL_ENROLLMENT_KEY in the Worker's .dev.vars.
EXPO_PUBLIC_BODY_ANVIL_ENROLLMENT_KEY=
