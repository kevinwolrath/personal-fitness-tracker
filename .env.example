# Copy to .env.local (git-ignored) for local web and Android development. Never commit real values.
# Production Google Play builds get the key from the GitHub Actions secret BODY_ANVIL_ENROLLMENT_KEY instead.

# Health-sync API, e.g. a local Worker started with `wrangler dev` (http only for localhost / 10.0.2.2).
EXPO_PUBLIC_HEALTH_SYNC_URL=
# Must equal BODY_ANVIL_ENROLLMENT_KEY in the Worker's .dev.vars.
EXPO_PUBLIC_BODY_ANVIL_ENROLLMENT_KEY=
