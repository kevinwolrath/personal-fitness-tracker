{
  "name": "personal-fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "check:native": "expo export --platform ios --platform android --output-dir dist-native"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "ajv": "^8.20.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts"
        ]
      },
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/src/**/*.native.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/jest.native-setup.js"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "testMatch": [
          "<rootDir>/src/**/*.native.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/jest.native-setup.js"
        ]
      }
    ]
  }
}
