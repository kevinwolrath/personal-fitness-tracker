{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevinwolrath/personal-fitness-tracker/docs/design-contracts/plan.schema.json",
  "title": "Personal Fitness Tracker plan package",
  "description": "formatVersion 1 and 2. Authoritative contract: see 03-plan-format.md and 07-ai-configuration.md for semantics and rules that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "revision",
    "title",
    "units",
    "dayTypes",
    "schedule",
    "activities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "pft-plan"
    },
    "formatVersion": {
      "enum": [
        1,
        2
      ]
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/label"
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass",
        "energy",
        "length"
      ],
      "properties": {
        "mass": {
          "enum": [
            "kg",
            "lb"
          ]
        },
        "energy": {
          "enum": [
            "kJ",
            "kcal"
          ]
        },
        "length": {
          "enum": [
            "cm",
            "in"
          ]
        }
      }
    },
    "dayTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "schedule": {
      "description": "Default day type for each weekday. Every weekday is required.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "properties": {
        "mon": {
          "$ref": "#/$defs/id"
        },
        "tue": {
          "$ref": "#/$defs/id"
        },
        "wed": {
          "$ref": "#/$defs/id"
        },
        "thu": {
          "$ref": "#/$defs/id"
        },
        "fri": {
          "$ref": "#/$defs/id"
        },
        "sat": {
          "$ref": "#/$defs/id"
        },
        "sun": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "quantity",
          "cadence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "quantity": {
            "enum": [
              "mass",
              "length",
              "number"
            ]
          },
          "unitLabel": {
            "type": "string",
            "maxLength": 12,
            "description": "Only for quantity 'number'."
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "cadence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "every"
                ],
                "properties": {
                  "every": {
                    "const": "day"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "every",
                  "on"
                ],
                "properties": {
                  "every": {
                    "const": "week"
                  },
                  "on": {
                    "$ref": "#/$defs/weekday"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "measurementId",
          "target",
          "direction"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "measurementId": {
            "$ref": "#/$defs/id"
          },
          "target": {
            "type": "number"
          },
          "direction": {
            "enum": [
              "decrease",
              "increase",
              "maintain"
            ]
          }
        }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "quantity"
            ],
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "quantity": {
                "enum": [
                  "energy",
                  "grams"
                ]
              },
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              },
              "appliesTo": {
                "$ref": "#/$defs/appliesTo"
              }
            }
          }
        },
        "eatingWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "quickLogs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "detail": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "exercise": {
      "$ref": "#/$defs/exercise"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "appliesTo": {
      "description": "Omit for every day. Exactly one selector.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dayTypes"
          ],
          "properties": {
            "dayTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/weekday"
              }
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "exercise",
            "meal",
            "habit"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "duration": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes"
              ],
              "properties": {
                "minutes": {
                  "$ref": "#/$defs/minutes"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "$ref": "#/$defs/minutes"
                },
                "max": {
                  "$ref": "#/$defs/minutes"
                }
              }
            }
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "appliesTo": {
          "$ref": "#/$defs/appliesTo"
        },
        "tracking": {
          "default": {
            "type": "check"
          },
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "check"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target",
                "unitLabel"
              ],
              "properties": {
                "type": {
                  "const": "count"
                },
                "target": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 12
                },
                "unitLabel": {
                  "type": "string",
                  "maxLength": 16
                }
              }
            }
          ]
        },
        "nutrition": {
          "description": "Meals only. Map of nutrition target id -> amount this meal contributes, in the target's quantity.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "flexible": {
          "type": "boolean",
          "default": false,
          "description": "Meals only. Amount not fixed; Today shows the remaining budget instead of nutrition values."
        }
      }
    },
    "movementId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "maxLength": 40
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "minutesRange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minutes"
          ],
          "properties": {
            "minutes": {
              "$ref": "#/$defs/minutes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/minutes"
            },
            "max": {
              "$ref": "#/$defs/minutes"
            }
          }
        }
      ]
    },
    "equipmentType": {
      "enum": [
        "kettlebell",
        "dumbbells",
        "free_weights",
        "barbell",
        "weight_plates",
        "home_gym",
        "cable_machine",
        "bench",
        "pull_up_bar",
        "resistance_bands",
        "heavy_bag",
        "boxing_gloves",
        "battle_ropes",
        "jump_rope",
        "exercise_bike",
        "treadmill",
        "rower",
        "bicycle",
        "vr_headset",
        "yoga_mat",
        "other"
      ]
    },
    "intensity": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goals": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "enum": [
              "weight_loss",
              "muscle_preservation",
              "muscle_gain",
              "strength",
              "fitness",
              "endurance",
              "mobility",
              "health",
              "other"
            ]
          }
        },
        "equipment": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "$ref": "#/$defs/equipmentType"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "weightsKg": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 500
                }
              },
              "notes": {
                "$ref": "#/$defs/note"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "movement",
              "status"
            ],
            "properties": {
              "movement": {
                "$ref": "#/$defs/movementId"
              },
              "status": {
                "enum": [
                  "avoid",
                  "caution",
                  "allowed"
                ]
              },
              "reason": {
                "$ref": "#/$defs/note"
              }
            }
          }
        },
        "substitutions": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instead",
              "use"
            ],
            "properties": {
              "instead": {
                "$ref": "#/$defs/movementId"
              },
              "use": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "$ref": "#/$defs/movementId"
                }
              },
              "reason": {
                "$ref": "#/$defs/note"
              }
            }
          }
        },
        "activityTypes": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/movementId"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "kind": {
                "enum": [
                  "strength",
                  "conditioning",
                  "cardio",
                  "mobility",
                  "sport",
                  "active_commute",
                  "other"
                ]
              },
              "intensity": {
                "$ref": "#/$defs/intensity"
              },
              "equipment": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/equipmentType"
                }
              },
              "notes": {
                "$ref": "#/$defs/note"
              }
            }
          }
        },
        "strength": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionsPerWeek": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14
            },
            "sessionMinutes": {
              "$ref": "#/$defs/minutesRange"
            },
            "intensity": {
              "$ref": "#/$defs/intensity"
            },
            "modalities": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/movementId"
              }
            },
            "notes": {
              "$ref": "#/$defs/note"
            },
            "split": {
              "enum": [
                "full_body",
                "upper_lower",
                "push_pull",
                "push_pull_legs",
                "circuit",
                "other"
              ]
            },
            "focus": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/note"
              }
            }
          }
        },
        "conditioning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sessionsPerWeek": {
              "type": "integer",
              "minimum": 0,
              "maximum": 14
            },
            "sessionMinutes": {
              "$ref": "#/$defs/minutesRange"
            },
            "intensity": {
              "$ref": "#/$defs/intensity"
            },
            "modalities": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/movementId"
              }
            },
            "notes": {
              "$ref": "#/$defs/note"
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location": {
              "enum": [
                "home",
                "gym",
                "outdoors",
                "mixed"
              ]
            },
            "gymMembership": {
              "type": "boolean"
            },
            "maxSessionMinutes": {
              "$ref": "#/$defs/minutes"
            },
            "notes": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/note"
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "heightCm": {
          "type": "number",
          "minimum": 50,
          "maximum": 260
        },
        "notes": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "formatVersion": {
        "const": 1
      }
    }
  },
  "then": {
    "not": {
      "anyOf": [
        {
          "required": [
            "profile"
          ]
        },
        {
          "required": [
            "exercise"
          ]
        }
      ]
    }
  }
}
