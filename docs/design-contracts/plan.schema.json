{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kevinwolrath/personal-fitness-tracker/docs/design-contracts/plan.schema.json",
  "title": "Personal Fitness Tracker plan package",
  "description": "formatVersion 1. Authoritative contract: see 03-plan-format.md for semantics and rules that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "id",
    "revision",
    "title",
    "units",
    "dayTypes",
    "schedule",
    "activities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "pft-plan"
    },
    "formatVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/label"
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass",
        "energy",
        "length"
      ],
      "properties": {
        "mass": {
          "enum": [
            "kg",
            "lb"
          ]
        },
        "energy": {
          "enum": [
            "kJ",
            "kcal"
          ]
        },
        "length": {
          "enum": [
            "cm",
            "in"
          ]
        }
      }
    },
    "dayTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "schedule": {
      "description": "Default day type for each weekday. Every weekday is required.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "properties": {
        "mon": {
          "$ref": "#/$defs/id"
        },
        "tue": {
          "$ref": "#/$defs/id"
        },
        "wed": {
          "$ref": "#/$defs/id"
        },
        "thu": {
          "$ref": "#/$defs/id"
        },
        "fri": {
          "$ref": "#/$defs/id"
        },
        "sat": {
          "$ref": "#/$defs/id"
        },
        "sun": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "quantity",
          "cadence"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "quantity": {
            "enum": [
              "mass",
              "length",
              "number"
            ]
          },
          "unitLabel": {
            "type": "string",
            "maxLength": 12,
            "description": "Only for quantity 'number'."
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 1
          },
          "cadence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "every"
                ],
                "properties": {
                  "every": {
                    "const": "day"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "every",
                  "on"
                ],
                "properties": {
                  "every": {
                    "const": "week"
                  },
                  "on": {
                    "$ref": "#/$defs/weekday"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "goals": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "measurementId",
          "target",
          "direction"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "measurementId": {
            "$ref": "#/$defs/id"
          },
          "target": {
            "type": "number"
          },
          "direction": {
            "enum": [
              "decrease",
              "increase",
              "maintain"
            ]
          }
        }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "quantity"
            ],
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/label"
              },
              "quantity": {
                "enum": [
                  "energy",
                  "grams"
                ]
              },
              "min": {
                "type": "number",
                "minimum": 0
              },
              "max": {
                "type": "number",
                "minimum": 0
              },
              "appliesTo": {
                "$ref": "#/$defs/appliesTo"
              }
            }
          }
        },
        "eatingWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/time"
            },
            "end": {
              "$ref": "#/$defs/time"
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/activity"
      }
    },
    "quickLogs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/label"
          },
          "detail": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "weekday": {
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "appliesTo": {
      "description": "Omit for every day. Exactly one selector.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dayTypes"
          ],
          "properties": {
            "dayTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "days"
          ],
          "properties": {
            "days": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/weekday"
              }
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "exercise",
            "meal",
            "habit"
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "detail": {
          "type": "string",
          "maxLength": 120
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "duration": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes"
              ],
              "properties": {
                "minutes": {
                  "$ref": "#/$defs/minutes"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "$ref": "#/$defs/minutes"
                },
                "max": {
                  "$ref": "#/$defs/minutes"
                }
              }
            }
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "appliesTo": {
          "$ref": "#/$defs/appliesTo"
        },
        "tracking": {
          "default": {
            "type": "check"
          },
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "check"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target",
                "unitLabel"
              ],
              "properties": {
                "type": {
                  "const": "count"
                },
                "target": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 12
                },
                "unitLabel": {
                  "type": "string",
                  "maxLength": 16
                }
              }
            }
          ]
        },
        "nutrition": {
          "description": "Meals only. Map of nutrition target id -> amount this meal contributes, in the target's quantity.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "flexible": {
          "type": "boolean",
          "default": false,
          "description": "Meals only. Amount not fixed; Today shows the remaining budget instead of nutrition values."
        }
      }
    }
  }
}
