{
  "name": "personal-fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "branding:build": "python scripts/build-branding.py",
    "store:prepare": "npm run export:web && node scripts/prepare-play-listing.cjs && node scripts/play-listing.js",
    "store:validate": "node scripts/play-listing.js --mode dry-run",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web",
    "check:native": "expo export --platform ios --platform android --output-dir dist-native",
    "test:e2e:dev": "E2E_DEV=1 playwright test",
    "replay:gamification": "node scripts/replay-gamification.cjs",
    "check:agent-files": "node scripts/check-agent-files.cjs",
    "check:sync-server": "node scripts/check-sync-server.cjs",
    "build:exercise-assets": "node scripts/build-exercise-assets.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "fflate": "0.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.0",
    "ajv": "^8.20.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "scripts",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/scripts/__tests__/*.test.js"
        ]
      },
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/**/*.test.ts"
        ]
      },
      {
        "displayName": "ios",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/src/**/*.native.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/jest.native-setup.js"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "testMatch": [
          "<rootDir>/src/**/*.native.test.tsx"
        ],
        "setupFiles": [
          "<rootDir>/test/jest.native-setup.js"
        ]
      }
    ]
  }
}
