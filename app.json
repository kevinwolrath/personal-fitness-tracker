{
  "expo": {
    "name": "Body Anvil",
    "icon": "./assets/branding/generated/launcher-1024.png",
    "slug": "personal-fitness-tracker",
    "scheme": "personalfitnesstracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/generated/notification-small.png",
          "color": "#ffb52e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/generated/splash-heroes.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/branding/generated/splash-heroes.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Body Anvil uses the camera to photograph a meal you want to log. Photos stay on this phone.",
          "photosPermission": "Body Anvil lets you choose a meal photo to log. Photos stay on this phone.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.questspire.personalfitnesstracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/generated/adaptive-foreground.png",
        "backgroundColor": "#1b0835",
        "monochromeImage": "./assets/branding/generated/adaptive-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_SLEEP"
      ],
      "versionCode": 1
    },
    "ios": {
      "icon": "./assets/branding/generated/launcher-1024.png",
      "bundleIdentifier": "com.questspire.personalfitnesstracker"
    },
    "web": {
      "favicon": "./assets/branding/generated/favicon-48.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
