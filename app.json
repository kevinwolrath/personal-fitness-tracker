{
  "expo": {
    "name": "Personal Fitness Tracker",
    "slug": "personal-fitness-tracker",
    "scheme": "personalfitnesstracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.questspire.personalfitnesstracker",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.questspire.personalfitnesstracker"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
