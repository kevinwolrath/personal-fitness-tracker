{
  "expo": {
    "name": "Body Anvil",
    "icon": "./store/google-play/en-US/images/icon.png",
    "slug": "personal-fitness-tracker",
    "scheme": "personalfitnesstracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.questspire.personalfitnesstracker",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_SLEEP"
      ],
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.questspire.personalfitnesstracker"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
